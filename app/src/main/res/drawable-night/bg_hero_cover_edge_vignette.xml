<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Neutral obsidian bottom-to-top edge gradient for text & button legibility -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#D814130F"
                android:centerColor="#4014130F"
                android:endColor="#1A14130F"
                android:type="linear" />
        </shape>
    </item>
    <!-- Neutral obsidian left-to-right edge vignette -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#8C14130F"
                android:centerColor="#2014130F"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>

