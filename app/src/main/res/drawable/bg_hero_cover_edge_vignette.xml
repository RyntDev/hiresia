<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle bottom-to-top edge gradient for text & button legibility while keeping cover crystal clear -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#CC0D1711"
                android:centerColor="#330D1711"
                android:endColor="#1A0D1711"
                android:type="linear" />
        </shape>
    </item>
    <!-- Subtle left-to-right edge vignette -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#800D1711"
                android:centerColor="#180D1711"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>

