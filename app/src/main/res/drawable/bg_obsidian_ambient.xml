<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Obsidian Charcoal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#161617" />
        </shape>
    </item>

    <!-- Top soft luminous white-gray ambient blur glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.48"
                android:centerY="0.02"
                android:gradientRadius="68%p"
                android:startColor="#2CFFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00161617" />
        </shape>
    </item>

    <!-- Subtle lower ambient sheen for depth -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.82"
                android:centerY="0.72"
                android:gradientRadius="56%p"
                android:startColor="#10FFFFFF"
                android:endColor="#00161617" />
        </shape>
    </item>
</layer-list>

