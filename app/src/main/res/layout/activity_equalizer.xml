<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootEqualizer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top App Bar / Header -->
    <LinearLayout
        android:id="@+id/headerEqualizer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_chevron_right"
            android:rotation="180"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_primary"
            android:contentDescription="Kembali" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Equalizer 64-bit PEQ"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="-0.02"
            android:layout_marginStart="8dp"
            android:singleLine="true"
            android:ellipsize="end" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchEq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_selector"
            app:trackTint="@color/switch_track_selector" />

    </LinearLayout>

    <!-- Main Scrollable Content + Right-Docked Tactile Vertical Scroll Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:id="@+id/scrollEqualizer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/layoutScrollEqualizerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="24dp">

            <!-- Bit-Perfect Warning Banner (Quick Bypass Alert) -->
            <LinearLayout
                android:id="@+id/layoutBitPerfectBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search_pill"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_bitperfect_trimmed"
                    app:tint="@color/lime_primary"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mode Bit-Perfect Aktif"
                        android:textColor="@color/lime_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nyalakan switch Equalizer untuk menerapkan 64-bit Parametric EQ dan efek DSP."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Horizontal Preset Chips (Normal, Bass, Vokal, Treble, Harman, Studio, Kustom) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/layoutChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/chipNormal"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:singleLine="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Normal"
                        android:textColor="@color/bg_dark"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_chip_selected"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipBass"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:singleLine="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Bass"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_chip_normal"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipVocal"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:singleLine="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Vokal"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_chip_normal"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipTreble"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:singleLine="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Treble"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_chip_normal"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipHarman"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:singleLine="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Harman"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_chip_normal"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipStudio"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:singleLine="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Studio"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_chip_normal"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipCustom"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:singleLine="true"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Kustom"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_chip_normal" />

                </LinearLayout>

            </HorizontalScrollView>

            <!-- PEQ Studio Quick Actions Bar -->
            <LinearLayout
                android:id="@+id/layoutPeqActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:weightSum="3"
                android:layout_marginBottom="12dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnImportAutoEq"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill_dark"
                    android:text="Import AutoEQ"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:includeFontPadding="false"
                    android:stateListAnimator="@null" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSavePreset"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_pill_dark"
                    android:text="Simpan Preset"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:includeFontPadding="false"
                    android:stateListAnimator="@null" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnMyPresets"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_dark"
                    android:text="Preset Saya"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:includeFontPadding="false"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <!-- Live Mathematical Combined Biquad Response Curve (20 Hz - 20 kHz) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardEqGraph"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardElevation="0dp"
                android:layout_marginBottom="12dp">

                <com.hiresia.audioplayer.ui.views.EQGfxView
                    android:id="@+id/eqGfxView"
                    android:layout_width="match_parent"
                    android:layout_height="176dp" />

            </androidx.cardview.widget.CardView>

            <!-- Preamp Attenuation / Gain Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPreamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardElevation="0dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/tvPreampTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preamp"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold" />

                    <SeekBar
                        android:id="@+id/seekPreamp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:max="270"
                        android:progress="150" />

                    <TextView
                        android:id="@+id/tvPreampValue"
                        android:layout_width="58dp"
                        android:layout_height="wrap_content"
                        android:text="0.0 dB"
                        android:gravity="end"
                        android:textColor="@color/lime_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 10-Band Tactile Faders Card + Left/Right Horizontal Slider -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFaders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <HorizontalScrollView
                        android:id="@+id/hsvEqFaders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:paddingTop="12dp"
                        android:paddingBottom="6dp">

                    <LinearLayout
                        android:id="@+id/layoutEqBands"
                        android:layout_width="wrap_content"
                        android:layout_height="268dp"
                        android:orientation="horizontal"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:gravity="center_vertical">

                        <com.hiresia.audioplayer.ui.views.VerticalFaderView
                            android:id="@+id/fader0"
                            android:layout_width="58dp"
                            android:layout_height="match_parent" />

                        <com.hiresia.audioplayer.ui.views.VerticalFaderView
                            android:id="@+id/fader1"
                            android:layout_width="58dp"
                            android:layout_height="match_parent" />

                        <com.hiresia.audioplayer.ui.views.VerticalFaderView
                            android:id="@+id/fader2"
                            android:layout_width="58dp"
                            android:layout_height="match_parent" />

                        <com.hiresia.audioplayer.ui.views.VerticalFaderView
                            android:id="@+id/fader3"
                            android:layout_width="58dp"
                            android:layout_height="match_parent" />

                        <com.hiresia.audioplayer.ui.views.VerticalFaderView
                            android:id="@+id/fader4"
                            android:layout_width="58dp"
                            android:layout_height="match_parent" />

                        <com.hiresia.audioplayer.ui.views.VerticalFaderView
                            android:id="@+id/fader5"
                            android:layout_width="58dp"
                            android:layout_height="match_parent" />

                        <com.hiresia.audioplayer.ui.views.VerticalFaderView
                            android:id="@+id/fader6"
                            android:layout_width="58dp"
                            android:layout_height="match_parent" />

                        <com.hiresia.audioplayer.ui.views.VerticalFaderView
                            android:id="@+id/fader7"
                            android:layout_width="58dp"
                            android:layout_height="match_parent" />

                        <com.hiresia.audioplayer.ui.views.VerticalFaderView
                            android:id="@+id/fader8"
                            android:layout_width="58dp"
                            android:layout_height="match_parent" />

                        <com.hiresia.audioplayer.ui.views.VerticalFaderView
                            android:id="@+id/fader9"
                            android:layout_width="58dp"
                            android:layout_height="match_parent" />

                    </LinearLayout>

                    </HorizontalScrollView>

                    <!-- Left-Right Horizontal Scroll Slider for 10 EQ Bands -->
                    <LinearLayout
                        android:id="@+id/layoutEqHorizontalScroller"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/tvEqScrollLeft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="◄ 31 Hz"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-bold"
                            android:paddingStart="2dp"
                            android:paddingEnd="6dp" />

                        <SeekBar
                            android:id="@+id/seekEqHorizontalScroll"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_weight="1"
                            android:max="1000"
                            android:progress="0"
                            android:splitTrack="false" />

                        <TextView
                            android:id="@+id/tvEqScrollRight"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="16 kHz ►"
                            android:textColor="@color/text_muted"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-bold"
                            android:paddingStart="6dp"
                            android:paddingEnd="2dp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Preset Hint / Info Text -->
            <TextView
                android:id="@+id/tvPresetInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preset: Normal. Ketuk label frekuensi/Q di bawah pita untuk atur Filter, Fc &amp; Q."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="4dp" />

            <!-- Collapsible Header for Substantive Advanced DSP Features -->
            <LinearLayout
                android:id="@+id/btnToggleDspDetails"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvAdvancedDspTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fitur DSP Lanjutan (AutoGain, Crossfeed, Balance)"
                    android:textColor="@color/lime_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-bold" />

                <ImageView
                    android:id="@+id/ivChevronDsp"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/text_secondary" />

            </LinearLayout>

            <!-- Collapsible Substantive Features Container -->
            <LinearLayout
                android:id="@+id/layoutDspDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- AutoGain Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAutoGain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="AutoGain (Anti-Clipping)"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchAutoGain"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:thumbTint="@color/switch_thumb_selector"
                                app:trackTint="@color/switch_track_selector" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Mencegah distorsi digital berdasarkan puncak kurva biquad gabungan + limiter transparan."
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Crossfeed Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCrossfeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Binaural Crossfeed (Bauer Filter)"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/switchCrossfeed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:thumbTint="@color/switch_thumb_selector"
                                app:trackTint="@color/switch_track_selector" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Intensitas: "
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                            <SeekBar
                                android:id="@+id/seekCrossfeed"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="10"
                                android:progress="5" />

                            <TextView
                                android:id="@+id/tvCrossfeedVal"
                                android:layout_width="28dp"
                                android:layout_height="wrap_content"
                                android:text="5"
                                android:gravity="end"
                                android:textColor="@color/lime_primary"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Stereo Balance Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardBalance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Stereo Balance"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <SeekBar
                            android:id="@+id/seekBalance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:max="100"
                            android:progress="50" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="L (100%)"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvBalanceValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tengah (Center)"
                                android:textColor="@color/lime_primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="end"
                                android:text="R (100%)"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <com.hiresia.audioplayer.ui.views.VerticalScrollBarView
            android:id="@+id/eqVerticalScrollRail"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp" />

    </LinearLayout>

    <!-- Bottom Reset Button ("Atur ulang") -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        android:paddingTop="8dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnResetEq"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Atur ulang"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/bg_pill_dark"
            android:gravity="center"
            android:singleLine="true"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:includeFontPadding="false"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>
