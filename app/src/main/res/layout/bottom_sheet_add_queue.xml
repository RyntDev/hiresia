<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_audio"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:id="@+id/viewDragHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pill_dark"
        android:layout_marginBottom="16dp" />

    <!-- Sheet Title -->
    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tambah ke antrean"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:fontFamily="sans-serif-bold"
        android:layout_marginBottom="16dp" />

    <!-- Option 1: Lagu -->
    <LinearLayout
        android:id="@+id/btnOptionAddSongs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/layoutIconAddSongs"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_lime">

            <ImageView
                android:id="@+id/ivIconAddSongs"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_music_note_large"
                app:tint="@color/on_accent" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvLabelAddSongs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lagu"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/tvSubAddSongs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih satu atau beberapa lagu dari pustaka"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/viewDividerAddQueue"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_line"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- Option 2: Grup playlist -->
    <LinearLayout
        android:id="@+id/btnOptionAddPlaylist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/layoutIconAddPlaylist"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_lime">

            <ImageView
                android:id="@+id/ivIconAddPlaylist"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_queue"
                app:tint="@color/on_accent" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvLabelAddPlaylist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grup playlist"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/tvSubAddPlaylist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tambahkan seluruh isi playlist sebagai satu grup"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
