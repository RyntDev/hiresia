<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_audio"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:id="@+id/viewDragHandle"
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:background="#363B48"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp" />

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audio output"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-bold" />

        <TextView
            android:id="@+id/tvSheetBitPerfectBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BIT-PERFECT"
            android:textColor="@color/on_accent"
            android:textSize="10sp"
            android:fontFamily="sans-serif-bold"
            android:background="@drawable/bg_pill_lime"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginStart="10dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnSheetClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close_white"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_secondary"
            android:contentDescription="Tutup" />

    </LinearLayout>

    <View
        android:id="@+id/viewSheetDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E222D"
        android:layout_marginBottom="12dp" />

    <!-- Scrollable Audio Pipeline Timeline -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp">

            <!-- ================= NODE 1: AUDIO SOURCE ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Left Title -->
                <TextView
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:text="Audio\nSource"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:paddingTop="4dp"
                    android:layout_marginEnd="8dp" />

                <!-- Middle Icon + Connector Line -->
                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <FrameLayout
                        android:id="@+id/layoutNodeSourceCircle"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_node_circle_active">

                        <ImageView
                            android:id="@+id/ivNodeSourceIcon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_node_source"
                            app:tint="@color/on_accent" />

                    </FrameLayout>

                    <View
                        android:id="@+id/lineNode1"
                        android:layout_width="2dp"
                        android:layout_height="48dp"
                        android:background="#363B48" />

                </LinearLayout>

                <!-- Right Parameters -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/tvSourcePath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Path: /storage/emulated/0/Music/track.flac"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:id="@+id/tvSourceFormatDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="FLAC • 44.1 kHz / 16-bit • Stereo"
                        android:textColor="@color/lime_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="3dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ================= NODE 2: HIRESIA ENGINE ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:text="Hiresia\nEngine"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:paddingTop="4dp"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <FrameLayout
                        android:id="@+id/layoutNodeEngineCircle"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_node_circle_inactive">

                        <ImageView
                            android:id="@+id/ivNodeEngineIcon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_node_engine"
                            app:tint="@color/text_secondary" />

                    </FrameLayout>

                    <View
                        android:id="@+id/lineNode2"
                        android:layout_width="2dp"
                        android:layout_height="52dp"
                        android:background="#363B48" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="App version: 2.0 (C++ Engine)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvEngineInput"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Input: 44.1 kHz"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvEngineOutput"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Output: 44.1 kHz"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvEngineProcessing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Processing: Bit-Perfect Direct Pass (0 dB)"
                        android:textColor="@color/lime_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ================= NODE 3: EQUALIZER (EQ) ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:text="EQ"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:paddingTop="4dp"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <FrameLayout
                        android:id="@+id/layoutNodeEqCircle"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_node_circle_inactive">

                        <ImageView
                            android:id="@+id/ivNodeEqIcon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_node_eq"
                            app:tint="@color/text_secondary" />

                    </FrameLayout>

                    <View
                        android:id="@+id/lineNode3"
                        android:layout_width="2dp"
                        android:layout_height="40dp"
                        android:background="#363B48" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/tvEqState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="State: Bypassed (Bit-Perfect active)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvEqConfig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Config: 10-Band Graphic EQ (Flat)"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ================= NODE 4: CROSSFEED ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:text="Crossfeed"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:paddingTop="4dp"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <FrameLayout
                        android:id="@+id/layoutNodeCrossfeedCircle"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_node_circle_inactive">

                        <ImageView
                            android:id="@+id/ivNodeCrossfeedIcon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_node_crossfeed"
                            app:tint="@color/text_secondary" />

                    </FrameLayout>

                    <View
                        android:id="@+id/lineNode4"
                        android:layout_width="2dp"
                        android:layout_height="36dp"
                        android:background="#363B48" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/tvCrossfeedState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="State: Bypassed (Bit-Perfect active)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ================= NODE 5: VOLUME ENGINE ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:text="Volume\nEngine"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:paddingTop="4dp"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <FrameLayout
                        android:id="@+id/layoutNodeVolumeCircle"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_node_circle_inactive">

                        <ImageView
                            android:id="@+id/ivNodeVolumeIcon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_node_volume"
                            app:tint="@color/text_secondary" />

                    </FrameLayout>

                    <View
                        android:id="@+id/lineNode5"
                        android:layout_width="2dp"
                        android:layout_height="44dp"
                        android:background="#363B48" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/tvVolumeMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mode: Bit-Perfect Locked (0.0 dB)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvVolumeLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Level: 0.0 dB (100% Unity Gain)"
                        android:textColor="@color/lime_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ================= NODE 6: SIGNAL OUTPUT ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:text="Signal\nOutput"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="end"
                    android:paddingTop="4dp"
                    android:layout_marginEnd="8dp" />

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <FrameLayout
                        android:id="@+id/layoutNodeOutputCircle"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_node_circle_active">

                        <ImageView
                            android:id="@+id/ivNodeOutputIcon"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_node_output"
                            app:tint="@color/on_accent" />

                    </FrameLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tvOutputDriver"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Output: Hi-Res Direct Driver (Bypass OS)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvOutputDevice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Device: Internal Phone Audio"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvOutputRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sampling Rate: 44.1 kHz"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvOutputBits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bits: 16 bits"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvOutputChannels"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Channels: 2 (Stereo)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvOutputFormat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Format: Direct PCM"
                        android:textColor="@color/lime_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
