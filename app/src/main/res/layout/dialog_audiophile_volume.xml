<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_glass"
    android:padding="20dp">

    <!-- Header: Title, Badge, and Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kontrol Volume"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/tvVolumeModeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HARDWARE DAC VOLUME"
                android:textColor="@color/lime_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnToggleHwBalance"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_button_step"
            android:gravity="center"
            android:text="Trim L/R"
            android:textColor="@color/lime_primary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnVolumeClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_secondary"
            android:contentDescription="Tutup" />

    </LinearLayout>

    <!-- Hero Decibel & Level Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvVolumeDbHero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-0.0 dB"
            android:textColor="@color/lime_primary"
            android:textSize="38sp"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:id="@+id/tvVolumePercentSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level: 100% • Kurva Logaritmik (-96 dB)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Volume SeekBar -->
    <SeekBar
        android:id="@+id/sbVolume"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:max="100"
        android:progress="80"
        android:thumbTint="@color/lime_primary"
        android:progressTint="@color/lime_primary"
        android:progressBackgroundTint="@color/border_line"
        android:splitTrack="false" />

    <!-- Min/Max Scale Labels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvVolumeMinLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="-∞ dB (Bisu)"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvVolumeMaxLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0 dB (Maks.)"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Quick Step & Tuning Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/btnVolMute"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_step"
            android:gravity="center"
            android:text="BISU"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnVolMinus"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_step"
            android:gravity="center"
            android:text="-1 dB"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnVolPlus"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_step"
            android:gravity="center"
            android:text="+1 dB"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold" />

        <TextView
            android:id="@+id/btnVolMax"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_step"
            android:gravity="center"
            android:text="0 dB"
            android:textColor="@color/lime_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Collapsible Hardware L/R Channel Balance Trim (Bit-Perfect DAC) -->
    <LinearLayout
        android:id="@+id/layoutHardwareBalanceRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHwBalanceTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Trim L/R Hardware DAC"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvHwBalanceValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tengah (0 dB)"
                android:textColor="@color/lime_primary"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold" />

        </LinearLayout>

        <SeekBar
            android:id="@+id/sbHwBalance"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:max="100"
            android:progress="50"
            android:splitTrack="false" />

    </LinearLayout>

    <!-- Bit-Perfect Warning / Notice Banner -->
    <LinearLayout
        android:id="@+id/layoutBitPerfectNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_dark_item"
        android:padding="12dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivBitPerfectNoticeIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_bitperfect_trimmed"
            app:tint="@color/lime_primary"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tvBitPerfectNoticeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mode Bit-Perfect Aktif: Software volume dinonaktifkan (0.0 dB) demi kemurnian bit 100%. Atur level suara pada knob/potentiometer fisik DAC atau Amp Anda."
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

</LinearLayout>
