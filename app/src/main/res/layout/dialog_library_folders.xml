<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="20dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pustaka Folder Musik"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Folder yang dipindai ke dalam pustaka Hiresia (C++ Engine)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnAddFolder"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip_selected"
            android:src="@android:drawable/ic_input_add"
            app:tint="@color/bg_dark"
            android:padding="8dp"
            android:contentDescription="Pindai Folder" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_card"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <!-- List of Scanned Folders -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLibraryFolders"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:scrollbars="vertical" />

    <!-- Scanning Progress Indicator (C++ Engine Scanner) -->
    <LinearLayout
        android:id="@+id/layoutScanStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_card"
        android:padding="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvScanStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Siap memindai"
            android:textColor="@color/gold_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="middle" />

        <ProgressBar
            android:id="@+id/pbScanProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:progress="0"
            android:max="100"
            android:progressTint="@color/cyan_accent"
            android:progressBackgroundTint="@color/surface_dark" />

    </LinearLayout>

    <!-- Bottom Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical|end">

        <Button
            android:id="@+id/btnAbortScan"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Hentikan"
            android:textColor="@color/red_accent"
            android:textSize="12sp"
            android:singleLine="true"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnRescanAll"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Pindai Ulang"
            android:textColor="@color/gold_accent"
            app:strokeColor="@color/gold_accent"
            android:textSize="12sp"
            android:singleLine="true"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnCloseDialog"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Tutup"
            android:backgroundTint="@color/surface_card"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:singleLine="true"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

</LinearLayout>
