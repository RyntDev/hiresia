<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="?attr/selectableItemBackground">

    <!-- Drag Handle (36dp touch target around 20dp icon) -->
    <ImageView
        android:id="@+id/ivTrackDragHandle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_drag_handle"
        app:tint="@color/text_secondary"
        android:layout_marginEnd="4dp"
        android:contentDescription="Geser urutan lagu" />

    <!-- Track Thumbnail -->
    <ImageView
        android:id="@+id/ivTrackThumb"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop" />

    <!-- Track Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvTrackTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Judul Lagu"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvTrackSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Artis · 3:45"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Remove Track Button ✕ -->
    <ImageButton
        android:id="@+id/btnRemoveTrack"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close_white"
        app:tint="@color/text_secondary"
        android:contentDescription="Hapus dari antrean" />

</LinearLayout>
